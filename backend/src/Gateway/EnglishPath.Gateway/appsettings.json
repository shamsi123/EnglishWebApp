{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" }
  },
  "AllowedHosts": "*",
  "Cors": { "AllowedOrigins": [] },
  "ReverseProxy": {
    "Routes": {
      "learning": {
        "ClusterId": "learning",
        "Match": { "Path": "/api/v1/learning/{**rest}" }
      },
      "progress": {
        "ClusterId": "progress",
        "Match": { "Path": "/api/v1/progress/{**rest}" }
      }
    },
    "Clusters": {
      "learning": {
        "Destinations": { "d1": { "Address": "http://learning-api:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health/live" } }
      },
      "progress": {
        "Destinations": { "d1": { "Address": "http://progress-api:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Path": "/health/live" } }
      }
    }
  }
}
