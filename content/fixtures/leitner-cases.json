{
  "intervalsDays": [
    1,
    2,
    4,
    7,
    14
  ],
  "cases": [
    {
      "name": "new item answered correctly goes to box 2",
      "box": null,
      "correct": true,
      "now": "2026-09-26T10:00:00Z",
      "expected": {
        "box": 2,
        "nextReviewAt": "2026-09-28T10:00:00Z"
      }
    },
    {
      "name": "new item answered wrong stays in box 1",
      "box": null,
      "correct": false,
      "now": "2026-09-26T10:00:00Z",
      "expected": {
        "box": 1,
        "nextReviewAt": "2026-09-27T10:00:00Z"
      }
    },
    {
      "name": "box 3 correct goes to box 4",
      "box": 3,
      "correct": true,
      "now": "2026-09-26T10:00:00Z",
      "expected": {
        "box": 4,
        "nextReviewAt": "2026-10-03T10:00:00Z"
      }
    },
    {
      "name": "box 4 wrong goes back to box 1",
      "box": 4,
      "correct": false,
      "now": "2026-09-26T10:00:00Z",
      "expected": {
        "box": 1,
        "nextReviewAt": "2026-09-27T10:00:00Z"
      }
    },
    {
      "name": "box 5 correct stays in box 5",
      "box": 5,
      "correct": true,
      "now": "2026-09-26T10:00:00Z",
      "expected": {
        "box": 5,
        "nextReviewAt": "2026-10-10T10:00:00Z"
      }
    },
    {
      "name": "second correct review on the same UTC day does not promote again",
      "box": 2,
      "lastReviewedAt": "2026-09-26T08:00:00Z",
      "previousNextReviewAt": "2026-09-28T08:00:00Z",
      "correct": true,
      "now": "2026-09-26T10:00:00Z",
      "expected": {
        "box": 2,
        "nextReviewAt": "2026-09-28T08:00:00Z"
      }
    },
    {
      "name": "wrong answer on the same day still resets to box 1",
      "box": 3,
      "lastReviewedAt": "2026-09-26T08:00:00Z",
      "previousNextReviewAt": "2026-09-30T08:00:00Z",
      "correct": false,
      "now": "2026-09-26T10:00:00Z",
      "expected": {
        "box": 1,
        "nextReviewAt": "2026-09-27T10:00:00Z"
      }
    },
    {
      "name": "correct review on the next day promotes",
      "box": 2,
      "lastReviewedAt": "2026-09-25T22:00:00Z",
      "previousNextReviewAt": "2026-09-27T22:00:00Z",
      "correct": true,
      "now": "2026-09-26T10:00:00Z",
      "expected": {
        "box": 3,
        "nextReviewAt": "2026-09-30T10:00:00Z"
      }
    }
  ]
}